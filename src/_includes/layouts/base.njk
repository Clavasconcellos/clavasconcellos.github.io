<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{{ title }}</title>
    {%- if route == 'home' %}
    <script>
      /* Pages used to be /#3tentos, /#resume…; send those old links to the new addresses */
      (() => {
        const redirect = () => {
          const route = location.hash.slice(1);
          if ({{ site.routes | dump | safe }}.includes(route)) location.replace('/' + route + '/');
          else if (route === 'home') history.replaceState(null, '', location.pathname);
        };
        redirect();
        addEventListener('hashchange', redirect);
      })();
    </script>
    {%- endif %}
    <script>
      /* Inline on purpose: it must run before the first paint. Visitors who will get Portuguese see
         the page only once the copy is translated (js/i18n.js), so English never flashes. 1.5s failsafe. */
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('cpv-lang');
        } catch {
          /* storage blocked */
        }
        const browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
        const pt = saved === 'pt' || (saved !== 'en' && browser.startsWith('pt'));
        if (!pt) return;
        document.documentElement.classList.add('i18n-wait');
        setTimeout(() => document.documentElement.classList.remove('i18n-wait'), 1500);
      })();
    </script>
    <style>
      .i18n-wait body {
        visibility: hidden;
      }
    </style>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="Clarissa Pilla Vasconcellos" />
    <meta name="theme-color" content="#ebe9e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#040814" media="(prefers-color-scheme: dark)" />
    {%- if route == 'notfound' %}
    <meta name="robots" content="noindex" />
    {%- else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    {%- endif %}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <!-- Link previews (LinkedIn, WhatsApp, Slack) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="CPV" />
    <meta property="og:title" content="{{ ogTitle or title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/assets/{{ ogImage or site.ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogAlt or site.ogAlt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=Nunito+Sans:ital,opsz,wght,YTLC@0,6..12,300..900,440..540&family=Reem+Kufi:wght@600;700&display=swap"
    />
    <script type="module" src="/js/main.js"></script>
    <link rel="modulepreload" href="/js/utils.js" />
    <link rel="modulepreload" href="/js/i18n.js" />
    <link rel="modulepreload" href="/js/i18n/pt.js" />
    <link rel="modulepreload" href="/js/header.js" />
    <link rel="modulepreload" href="/js/theme.js" />
    <link rel="modulepreload" href="/js/motion.js" />
    <link rel="modulepreload" href="/js/page.js" />
    <link rel="modulepreload" href="/js/background.js" />
    <link rel="modulepreload" href="/js/projects-list.js" />
    <link rel="modulepreload" href="/js/toast.js" />
    <link rel="modulepreload" href="/js/reveal.js" />
    <link rel="modulepreload" href="/js/compare.js" />
  </head>
  <body data-page="{{ route }}" data-title="{{ titleKey }}">
    {% include "partials/icons.njk" %}

    <a class="skip" href="#main" id="skip-link" data-i18n="skip">Skip to main content</a>

    {% include "partials/header.njk" %}

    <canvas id="leaf-bg" aria-hidden="true" hidden></canvas>
    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    {% include "partials/toast.njk" %}
  </body>
</html>
