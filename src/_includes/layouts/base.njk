<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Clarissa Pilla Vasconcellos | Product Designer</title>
    <script>
      /* Inline on purpose: it must run before the first paint. Visitors who will get Portuguese see
         the page only once the copy is translated (js/i18n.js), so English never flashes. 1.5s failsafe. */
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('cpv-lang');
        } catch {
          /* storage blocked */
        }
        const browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
        const pt = saved === 'pt' || (saved !== 'en' && browser.startsWith('pt'));
        if (!pt) return;
        document.documentElement.classList.add('i18n-wait');
        setTimeout(() => document.documentElement.classList.remove('i18n-wait'), 1500);
      })();
    </script>
    <style>
      .i18n-wait body {
        visibility: hidden;
      }
    </style>
    <meta
      name="description"
      content="Portfólio de Clarissa Pilla Vasconcellos, Product Designer em Porto Alegre, Brasil."
    />
