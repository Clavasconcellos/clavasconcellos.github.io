<div class="view" id="view-3tentos" data-view="3tentos" hidden>
  <section class="case-hero">
    <div class="wrap">
      <h1 class="t-hero-s">
        <span data-i18n="cH1a">From field to screen:</span>
        <span class="line2" data-i18n="cH1b"
